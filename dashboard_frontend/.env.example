# API Configuration
# Backend API base URL
REACT_APP_API_BASE=http://localhost:8000

# Backend server URL (if different from API base)
REACT_APP_BACKEND_URL=http://localhost:8000

# Frontend application URL
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL for real-time features
REACT_APP_WS_URL=ws://localhost:8000/ws

# Application Environment
# Options: development, staging, production
REACT_APP_NODE_ENV=development

# Performance & Debugging
# Disable Next.js telemetry
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Enable source maps in production (set to false for production)
REACT_APP_ENABLE_SOURCE_MAPS=true

# Server Configuration
# Application port
REACT_APP_PORT=3000

# Trust proxy headers (for deployment behind proxy)
REACT_APP_TRUST_PROXY=true

# Logging & Monitoring
# Log level: debug, info, warn, error
REACT_APP_LOG_LEVEL=info

# Health check endpoint path
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature Flags
# JSON object for feature toggles
REACT_APP_FEATURE_FLAGS={}

# Enable experimental features
REACT_APP_EXPERIMENTS_ENABLED=false

# Optional: Analytics & Tracking
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
# REACT_APP_SENTRY_DSN=https://xxx@sentry.io/xxx

# Optional: Authentication
# REACT_APP_AUTH_DOMAIN=auth.example.com
# REACT_APP_AUTH_CLIENT_ID=your-client-id

# Optional: External Services
# REACT_APP_STRIPE_PUBLIC_KEY=pk_test_xxx
# REACT_APP_MAPBOX_TOKEN=pk.xxx

# Note: All environment variables MUST be prefixed with REACT_APP_
# to be accessible in the React application via process.env
